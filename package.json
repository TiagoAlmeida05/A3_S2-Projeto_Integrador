{
  "name": "jupiter-qda",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:react": "cd frontend && npm run build",
    "build:win": "npm run build:react && electron-builder --win",
    "build:mac": "npm run build:react && electron-builder --mac",
    "build:linux": "npm run build:react && electron-builder --linux",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Qualitative Data Analysis Tool",
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "pdfjs-dist": "^5.6.205",
    "react-pdf": "^10.4.1",
    "react-resizable-panels": "^4.12.1"

  },
  "build": {
    "appId": "com.jupiter.qda",
    "productName": "jUPiter QDA",
    "directories": {
      "output": "release/"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "frontend/dist/**/*",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/jupiter-backend",
        "to": "backend/jupiter-backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "build/logo.icns",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/logo.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/logo.png",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    }
  }
}
